<view class="home-container">
  <nav title-text="{{title}}" />

  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 顶部信息条：固定在滚动区域顶部，显示总数和提示 -->
    <view class="home-bar">
      <text class="home-bar__count">{{total}} 张</text>
      <text class="home-bar__hint">点击播放</text>
    </view>

    <view class="home-grid">
      <block wx:for="{{rows}}" wx:for-item="row" wx:key="index">
        <!-- 分组标题：带一条竖色条，标出分类边界 -->
        <view wx:if="{{row.groupStart}}" class="home-group">
          <view class="home-group__bar" />
          <text class="home-group__text">{{row.label}}</text>
          <text class="home-group__count">{{row.count}} 张</text>
        </view>

        <view class="home-grid__row {{row.partial ? 'home-grid__row--partial' : ''}}">
          <view
            wx:for="{{row.items}}"
            wx:for-item="pic"
            wx:key="image"
            class="home-cell {{row.columns > 2 ? 'home-cell--shrink' : ''}}"
            style="width: {{pic.width}}px; height: {{pic.height}}px;"
            hover-class="home-cell--active"
            hover-stay-time="120"
            bind:tap="onImageTap"
            data-audio="{{pic.audio}}"
          >
            <t-image
              t-class="home-cell__image"
              src="{{pic.image}}"
              mode="scaleToFill"
              lazy
              bind:error="onImageError"
            />
          </view>
        </view>
      </block>

      <view class="home-end">— 到底了 —</view>
    </view>
  </scroll-view>
</view>
